---
import BaseLayout from '../layouts/BaseLayout.astro';
import { settings } from '../config/site';
import { getAddons, getBusiness, getCategories } from '../lib/content';
import { generalInquiryUrl } from '../lib/whatsapp';

const business = await getBusiness();
const categories = await getCategories();
const addons = await getAddons();

/** קישור גיבוי — למי שאין לו JS, או שמעדיף פשוט לכתוב */
const plainWaHref = generalInquiryUrl(business.whatsappNumber, business.ownerName);

const steps = [
  { id: 'what', label: 'מה מזמינים' },
  { id: 'when', label: 'מתי ואיך' },
  { id: 'who', label: 'מי אתם' },
];
---

<BaseLayout
  title="הזמנה"
  description="ממלאים שלושה שלבים קצרים והפרטים נפתחים כהודעת וואטסאפ מסודרת — בלי הרשמה ובלי תשלום באתר."
  whatsappFloat={false}
>
  <div class="wrap intro">
    <h1 class="intro__title">בואו נתחיל את ההזמנה</h1>
    <p class="intro__lead">
      שלושה שלבים קצרים. בסוף נפתחת אצלכם בוואטסאפ הודעה מוכנה עם כל הפרטים — אתם רק
      לוחצים שליחה. <strong>שום דבר לא נשלח לפני שתלחצו.</strong>
    </p>

    <noscript>
      <p class="noscript-note">
        הטופס משתמש ב-JavaScript כדי להרכיב את ההודעה. אפשר פשוט
        <a href={plainWaHref} target="_blank" rel="noopener noreferrer">
          לפתוח שיחת וואטסאפ ולכתוב לי ישירות
        </a>
        — ציינו תאריך אירוע, מספר מנות וסוג המוצר.
      </p>
    </noscript>
  </div>

  <div class="wrap form-area">
    <form
      id="order-form"
      novalidate
      data-whatsapp={business.whatsappNumber}
      data-owner={business.ownerName}
      data-default-lead={business.minLeadTimeDays}
    >
      <ol class="progress" id="progress">
        {
          steps.map((step, index) => (
            <li class="progress__item" data-progress={index + 1}>
              <span class="progress__num num">{index + 1}</span>
              <span class="progress__label">{step.label}</span>
            </li>
          ))
        }
      </ol>

      <p class="sr-only" id="step-status" role="status" aria-live="polite"></p>

      {/* ---------- שלב 1: מה ---------- */}
      <fieldset class="step" data-step="1" tabindex="-1">
        <legend class="step__legend">
          <span class="step__count num">שלב 1 מתוך 3</span>
          <span class="step__title">מה מזמינים</span>
        </legend>

        <div class="field">
          <label for="category">סוג המוצר <span class="req" aria-hidden="true">*</span></label>
          <select id="category" name="category" required aria-describedby="category-error">
            <option value="">בחרו מוצר</option>
            {
              categories.map((category) => (
                <option
                  value={category.data.name}
                  data-slug={category.data.slug}
                  data-lead={category.data.leadTimeDays ?? business.minLeadTimeDays}
                >
                  {category.data.name}
                </option>
              ))
            }
          </select>
          <p class="error" id="category-error" role="alert" hidden></p>
        </div>

        <div class="field">
          <label for="servings">כמה מנות <span class="req" aria-hidden="true">*</span></label>
          <select id="servings" name="servings" required aria-describedby="servings-error">
            <option value="">בחרו כמות</option>
            {settings.orderForm.guestCounts.map((count) => <option value={count}>{count}</option>)}
          </select>
          <p class="error" id="servings-error" role="alert" hidden></p>
        </div>

        <div class="field">
          <label for="flavor">טעם ומילוי</label>
          <select id="flavor" name="flavor" aria-describedby="flavor-hint">
            <option value="">עדיין לא החלטתי</option>
            {
              categories.map((category) => (
                <optgroup label={category.data.name} data-category={category.data.name}>
                  {category.data.flavors.map((flavor) => <option value={flavor}>{flavor}</option>)}
                </optgroup>
              ))
            }
          </select>
          <p class="hint" id="flavor-hint">הרשימה מסתננת לפי המוצר שבחרתם. אפשר גם להשאיר ריק.</p>
        </div>

        <div class="field">
          <label for="inscription">כיתוב על המוצר</label>
          <input
            type="text"
            id="inscription"
            name="inscription"
            maxlength="60"
            autocomplete="off"
            aria-describedby="inscription-hint"
          />
          <p class="hint" id="inscription-hint">
            בדיוק כפי שיודפס — כולל ניקוד, סימני פיסוק ואותיות גדולות באנגלית.
          </p>
        </div>

        <fieldset class="field subfield">
          <legend class="field__legend">תוספות</legend>
          <ul class="checks">
            {
              addons.map((addon) => (
                <li>
                  <label class="check">
                    <input type="checkbox" name="addons" value={addon.data.name} />
                    <span>
                      <span class="check__name">{addon.data.name}</span>
                      <span class="check__price">
                        <span class="num">{addon.data.price.toLocaleString('he-IL')}</span> ₪
                      </span>
                    </span>
                  </label>
                </li>
              ))
            }
          </ul>
        </fieldset>
      </fieldset>

      {/* ---------- שלב 2: מתי ---------- */}
      <fieldset class="step" data-step="2" tabindex="-1" hidden>
        <legend class="step__legend">
          <span class="step__count num">שלב 2 מתוך 3</span>
          <span class="step__title">מתי ואיך</span>
        </legend>

        <div class="field">
          <label for="event-date">תאריך האירוע <span class="req" aria-hidden="true">*</span></label>
          <input
            type="date"
            id="event-date"
            name="eventDate"
            required
            aria-describedby="event-date-hint event-date-error"
          />
          <p class="hint" id="event-date-hint">
            זמן התראה מינימלי: <span class="num">{business.minLeadTimeDays}</span> ימים, ולעוגות
            מעוצבות <span class="num">{business.customLeadTimeDays}</span> ימים.
          </p>
          <p class="notice" id="event-date-warning" role="status" hidden></p>
          <p class="error" id="event-date-error" role="alert" hidden></p>
        </div>

        <fieldset class="field subfield">
          <legend class="field__legend">
            איסוף או משלוח <span class="req" aria-hidden="true">*</span>
          </legend>
          <div class="radios" aria-describedby="delivery-error">
            <label class="radio">
              <input type="radio" name="delivery" value="איסוף עצמי" required checked />
              <span>
                <span class="radio__name">איסוף עצמי</span>
                <span class="radio__note">{business.pickupNote}</span>
              </span>
            </label>
            <label class="radio">
              <input type="radio" name="delivery" value="משלוח" required />
              <span>
                <span class="radio__name">משלוח</span>
                <span class="radio__note">{business.deliveryNote}</span>
              </span>
            </label>
          </div>
          <p class="error" id="delivery-error" role="alert" hidden></p>
        </fieldset>

        <div class="field" id="address-field" hidden>
          <label for="address">כתובת למשלוח <span class="req" aria-hidden="true">*</span></label>
          <input
            type="text"
            id="address"
            name="address"
            autocomplete="street-address"
            aria-describedby="address-hint address-error"
            disabled
          />
          <p class="hint" id="address-hint">
            רחוב, מספר ויישוב. אזורי המשלוח: {business.deliveryAreas.join(' · ')}.
          </p>
          <p class="error" id="address-error" role="alert" hidden></p>
        </div>

        <div class="field">
          <label for="budget">טווח תקציב <span class="req" aria-hidden="true">*</span></label>
          <select id="budget" name="budget" required aria-describedby="budget-notice budget-error">
            <option value="">בחרו טווח</option>
            {
              settings.orderForm.budgetRanges.map((range) => (
                <option value={range.value} data-low={range.tooLow ? 'true' : 'false'}>
                  {range.value}
                </option>
              ))
            }
          </select>
          <p class="notice" id="budget-notice" hidden>
            שווה לדעת מראש: מינימום הזמנה הוא
            <span class="num">{business.minOrderIls.toLocaleString('he-IL')}</span> ₪, ורוב
            ההזמנות נעות סביב מחירי המחירון. אפשר בהחלט להמשיך — פשוט שנדע שתיאמנו ציפיות.
          </p>
          <p class="error" id="budget-error" role="alert" hidden></p>
        </div>
      </fieldset>

      {/* ---------- שלב 3: מי ---------- */}
      <fieldset class="step" data-step="3" tabindex="-1" hidden>
        <legend class="step__legend">
          <span class="step__count num">שלב 3 מתוך 3</span>
          <span class="step__title">מי אתם</span>
        </legend>

        <div class="field">
          <label for="name">שם <span class="req" aria-hidden="true">*</span></label>
          <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
            aria-describedby="name-error"
          />
          <p class="error" id="name-error" role="alert" hidden></p>
        </div>

        <div class="field">
          <label for="phone">טלפון <span class="req" aria-hidden="true">*</span></label>
          <input
            type="tel"
            id="phone"
            name="phone"
            required
            inputmode="tel"
            autocomplete="tel"
            aria-describedby="phone-hint phone-error"
          />
          <p class="hint" id="phone-hint">כדי שאוכל לחזור אליכם גם אם הצ'אט נבלע.</p>
          <p class="error" id="phone-error" role="alert" hidden></p>
        </div>

        <div class="field">
          <label for="allergies">אלרגיות או רגישויות</label>
          <textarea id="allergies" name="allergies" rows="2" aria-describedby="allergies-hint"
          ></textarea>
          <p class="hint" id="allergies-hint">{business.allergens.statement}</p>
        </div>

        <div class="field">
          <label for="inspiration">קישור לתמונת השראה</label>
          <input
            type="url"
            id="inspiration"
            name="inspiration"
            inputmode="url"
            placeholder="https://"
            aria-describedby="inspiration-hint inspiration-error"
          />
          <p class="hint" id="inspiration-hint">
            אין באתר העלאת קבצים — הוא אתר סטטי בלי שרת, וזה מה שמשאיר אותו מהיר.
            אפשר להדביק כאן קישור (אינסטגרם, פינטרסט), או פשוט <strong>לצרף את התמונה
            ישירות בשיחת הוואטסאפ</strong> שתיפתח בסוף.
          </p>
          <p class="error" id="inspiration-error" role="alert" hidden></p>
        </div>

        <div class="field">
          <label for="notes">משהו נוסף שכדאי שאדע</label>
          <textarea id="notes" name="notes" rows="3"></textarea>
        </div>
      </fieldset>

      <div class="actions">
        <button type="button" class="btn btn--ghost" id="prev-btn" hidden>הקודם</button>
        <button type="button" class="btn btn--primary" id="next-btn">לשלב הבא</button>
        <button type="submit" class="btn btn--primary" id="submit-btn" hidden>
          פתיחת ההודעה בוואטסאפ
        </button>
      </div>
    </form>

    {/* מסך הסיום — מוצג במקום הטופס אחרי הרכבת ההודעה */}
    <section class="sent" id="sent-panel" tabindex="-1" hidden aria-labelledby="sent-title">
      <h2 class="sent__title" id="sent-title">ההזמנה נפתחת בוואטסאפ</h2>
      <p class="sent__text">
        פתחתי לכם חלון וואטסאפ עם ההודעה מוכנה. <strong>ההודעה עדיין לא נשלחה</strong> — עברו
        עליה, צרפו תמונת השראה אם יש, ולחצו שליחה.
      </p>
      <p class="sent__text">אם החלון לא נפתח (חוסם חלונות קופצים, למשל):</p>
      <p class="sent__actions">
        <a class="btn btn--primary" id="sent-link" href={plainWaHref} target="_blank" rel="noopener noreferrer">
          פתיחת וואטסאפ ידנית
        </a>
        <button type="button" class="btn btn--ghost" id="copy-btn">העתקת ההודעה</button>
        <button type="button" class="btn btn--ghost" id="back-btn">חזרה לעריכת הפרטים</button>
      </p>
      <p class="sent__copied" id="copy-status" role="status" aria-live="polite"></p>

      <details class="sent__preview">
        <summary>הצגת ההודעה שהורכבה</summary>
        <pre class="sent__pre" id="message-preview"></pre>
      </details>
    </section>
  </div>
</BaseLayout>

<script>
  /**
   * טופס ההזמנה — אין כאן שליחה לשרת.
   * הסקריפט מרכיב מחרוזת טקסט מהשדות ופותח wa.me (CLAUDE.md סעיף 3).
   */
  const form = document.querySelector<HTMLFormElement>('#order-form');
  const panel = document.querySelector<HTMLElement>('#sent-panel');

  if (form && panel) {
    const steps = Array.from(form.querySelectorAll<HTMLFieldSetElement>('[data-step]'));
    const progressItems = Array.from(form.querySelectorAll<HTMLElement>('[data-progress]'));
    const status = form.querySelector<HTMLElement>('#step-status')!;
    const prevBtn = form.querySelector<HTMLButtonElement>('#prev-btn')!;
    const nextBtn = form.querySelector<HTMLButtonElement>('#next-btn')!;
    const submitBtn = form.querySelector<HTMLButtonElement>('#submit-btn')!;

    const categorySelect = form.querySelector<HTMLSelectElement>('#category')!;
    const flavorSelect = form.querySelector<HTMLSelectElement>('#flavor')!;
    const dateInput = form.querySelector<HTMLInputElement>('#event-date')!;
    const dateWarning = form.querySelector<HTMLElement>('#event-date-warning')!;
    const budgetSelect = form.querySelector<HTMLSelectElement>('#budget')!;
    const budgetNotice = form.querySelector<HTMLElement>('#budget-notice')!;
    const addressField = form.querySelector<HTMLElement>('#address-field')!;
    const addressInput = form.querySelector<HTMLInputElement>('#address')!;

    const sentLink = panel.querySelector<HTMLAnchorElement>('#sent-link')!;
    const preview = panel.querySelector<HTMLElement>('#message-preview')!;
    const copyBtn = panel.querySelector<HTMLButtonElement>('#copy-btn')!;
    const copyStatus = panel.querySelector<HTMLElement>('#copy-status')!;
    const backBtn = panel.querySelector<HTMLButtonElement>('#back-btn')!;

    let current = 0;

    // ---------- שלבים ----------

    function showStep(index: number) {
      current = Math.max(0, Math.min(index, steps.length - 1));
      steps.forEach((step, i) => (step.hidden = i !== current));
      progressItems.forEach((item, i) => {
        item.dataset.state = i === current ? 'current' : i < current ? 'done' : 'todo';
      });
      prevBtn.hidden = current === 0;
      nextBtn.hidden = current === steps.length - 1;
      submitBtn.hidden = current !== steps.length - 1;
      status.textContent = `שלב ${current + 1} מתוך ${steps.length}`;
      steps[current]!.focus();
    }

    // ---------- ולידציה ----------

    function errorEl(field: HTMLElement): HTMLElement | null {
      return document.getElementById(`${field.id}-error`);
    }

    function setError(field: HTMLElement, message: string) {
      const box = errorEl(field);
      if (box) {
        box.textContent = message;
        box.hidden = !message;
      }
      if (message) field.setAttribute('aria-invalid', 'true');
      else field.removeAttribute('aria-invalid');
    }

    function pad(value: number) {
      return String(value).padStart(2, '0');
    }

    function toIsoDate(date: Date) {
      return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
    }

    /** זמן ההתראה של הקטגוריה שנבחרה, או ברירת המחדל של העסק */
    function leadDays(): number {
      const option = categorySelect.selectedOptions[0];
      const fromOption = Number(option?.dataset.lead);
      if (Number.isFinite(fromOption) && fromOption > 0) return fromOption;
      return Number(form!.dataset.defaultLead ?? 7);
    }

    function minDateIso(): string {
      const date = new Date();
      date.setHours(0, 0, 0, 0);
      date.setDate(date.getDate() + leadDays());
      return toIsoDate(date);
    }

    function formatDateHe(iso: string): string {
      const [year, month, day] = iso.split('-');
      return `${day}/${month}/${year}`;
    }

    function fieldError(field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement): string {
      if (field.disabled || field.type === 'checkbox' || field.type === 'radio') return '';
      const value = field.value.trim();
      if (field.required && !value) return 'שדה חובה. בלי זה לא אוכל לתמחר.';
      if (!value) return '';
      if (field.type === 'tel' && !/^0\d{1,2}-?\d{7}$/.test(value.replace(/\s/g, ''))) {
        return 'מספר טלפון לא תקין. לדוגמה: 050-1234567';
      }
      if (field.type === 'url' && !/^https?:\/\/.+/.test(value)) {
        return 'קישור חייב להתחיל ב-https://';
      }
      return '';
    }

    function validateStep(index: number): boolean {
      const step = steps[index]!;
      const fields = Array.from(
        step.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
          'input, select, textarea',
        ),
      );
      let firstInvalid: HTMLElement | null = null;

      for (const field of fields) {
        const message = fieldError(field);
        if (field.id) setError(field, message);
        if (message && !firstInvalid) firstInvalid = field;
      }

      if (firstInvalid) {
        firstInvalid.focus();
        return false;
      }
      return true;
    }

    // ---------- תלויות בין שדות ----------

    function syncFlavors() {
      const selected = categorySelect.value;
      const groups = Array.from(flavorSelect.querySelectorAll<HTMLOptGroupElement>('optgroup'));
      for (const group of groups) {
        const match = !selected || group.dataset.category === selected;
        group.hidden = !match;
        group.disabled = !match;
      }
      const chosen = flavorSelect.selectedOptions[0];
      if (chosen?.parentElement instanceof HTMLOptGroupElement && chosen.parentElement.hidden) {
        flavorSelect.value = '';
      }
    }

    /**
     * תאריך מוקדם מזמן ההתראה הוא אזהרה, לא חסימה.
     * לקוח שמוכן לשלם על דחיפות הוא לקוח — היא תחליט, לא הטופס.
     * במקום זה ההודעה מסמנת לה את זה בבירור.
     */
    function isDateTooSoon(): boolean {
      return Boolean(dateInput.value) && dateInput.value < minDateIso();
    }

    function syncDateMin() {
      const min = minDateIso();
      dateInput.min = min;
      dateWarning.hidden = !isDateTooSoon();
      if (isDateTooSoon()) {
        dateWarning.textContent = `שימו לב: זמן ההתראה הרגיל למוצר הזה מסתיים ב-${formatDateHe(min)}. אפשר לשלוח בכל זאת — אבדוק אם אני מצליחה להיכנס לתאריך.`;
      }
    }

    function syncAddress() {
      const delivery = form!.querySelector<HTMLInputElement>('input[name="delivery"]:checked');
      const needsAddress = delivery?.value === 'משלוח';
      addressField.hidden = !needsAddress;
      addressInput.disabled = !needsAddress;
      addressInput.required = needsAddress;
      if (!needsAddress) setError(addressInput, '');
    }

    function syncBudgetNotice() {
      const option = budgetSelect.selectedOptions[0];
      budgetNotice.hidden = option?.dataset.low !== 'true';
    }

    // ---------- הרכבת ההודעה ----------

    function line(label: string, value: string): string {
      return value ? `${label}: ${value}\n` : '';
    }

    function buildMessage(): string {
      const data = new FormData(form!);
      const get = (key: string) => String(data.get(key) ?? '').trim();
      const addonList = data.getAll('addons').map(String);
      const owner = form!.dataset.owner ?? '';

      let message = `היי ${owner}, הגעתי מהאתר ואשמח להזמין 🙂\n\n`;

      message += '*מה*\n';
      message += line('מוצר', get('category'));
      message += line('מספר מנות', get('servings'));
      message += line('טעם ומילוי', get('flavor'));
      message += line('כיתוב', get('inscription') ? `"${get('inscription')}"` : '');
      message += line('תוספות', addonList.join(', '));

      message += '\n*מתי ואיך*\n';
      message += line(
        'תאריך האירוע',
        get('eventDate')
          ? `${formatDateHe(get('eventDate'))}${isDateTooSoon() ? ' ⚠️ מוקדם מזמן ההתראה הרגיל' : ''}`
          : '',
      );
      message += line('אופן קבלה', get('delivery'));
      message += line('כתובת למשלוח', get('address'));
      message += line('טווח תקציב', get('budget'));

      message += '\n*מי*\n';
      message += line('שם', get('name'));
      message += line('טלפון', get('phone'));
      message += line('אלרגיות', get('allergies'));
      message += line('תמונת השראה', get('inspiration'));
      message += line('הערות', get('notes'));

      if (!get('inspiration')) {
        message += '\n(אצרף כאן תמונת השראה בצ׳אט)';
      }

      return message.trim();
    }

    // ---------- אירועים ----------

    nextBtn.addEventListener('click', () => {
      if (validateStep(current)) showStep(current + 1);
    });

    prevBtn.addEventListener('click', () => showStep(current - 1));

    categorySelect.addEventListener('change', () => {
      syncFlavors();
      syncDateMin();
    });

    dateInput.addEventListener('change', syncDateMin);
    budgetSelect.addEventListener('change', syncBudgetNotice);

    for (const radio of form.querySelectorAll<HTMLInputElement>('input[name="delivery"]')) {
      radio.addEventListener('change', syncAddress);
    }

    // ניקוי שגיאה ברגע שהמשתמש מתקן
    form.addEventListener('input', (event) => {
      const target = event.target as HTMLElement;
      if (target.id && target.getAttribute('aria-invalid') === 'true') {
        setError(target, fieldError(target as HTMLInputElement));
      }
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      // ולידציה על כל השלבים, לא רק על הנוכחי
      for (let i = 0; i < steps.length; i++) {
        const wasHidden = steps[i]!.hidden;
        steps[i]!.hidden = false;
        const ok = validateStep(i);
        if (!ok) {
          showStep(i);
          return;
        }
        steps[i]!.hidden = wasHidden;
      }

      const message = buildMessage();
      const number = (form!.dataset.whatsapp ?? '').replace(/\D/g, '');
      const url = `https://wa.me/${number}?text=${encodeURIComponent(message)}`;

      sentLink.href = url;
      preview.textContent = message;
      copyBtn.dataset.message = message;

      form!.hidden = true;
      panel!.hidden = false;
      panel!.focus();

      // נפתח בעקבות לחיצת המשתמש, ולכן לא אמור להיחסם. אם נחסם — יש קישור ידני.
      window.open(url, '_blank', 'noopener');
    });

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.message ?? '');
        copyStatus.textContent = 'ההודעה הועתקה. אפשר להדביק אותה בוואטסאפ.';
      } catch {
        copyStatus.textContent = 'ההעתקה לא עבדה בדפדפן הזה. אפשר לפתוח את ההודעה למטה ולהעתיק ידנית.';
      }
    });

    backBtn.addEventListener('click', () => {
      panel!.hidden = true;
      form!.hidden = false;
      showStep(steps.length - 1);
    });

    // ---------- אתחול ----------

    // קטגוריה שהגיעה מעמוד קטגוריה: /order?category=<slug>
    const requested = new URLSearchParams(window.location.search).get('category');
    if (requested) {
      const match = Array.from(categorySelect.options).find(
        (option) => option.dataset.slug === requested,
      );
      if (match) categorySelect.value = match.value;
    }

    syncFlavors();
    syncDateMin();
    syncAddress();
    syncBudgetNotice();
    showStep(0);
    // בטעינה אין להזיז את הפוקוס מראש העמוד
    window.scrollTo({ top: 0 });
  }
</script>

