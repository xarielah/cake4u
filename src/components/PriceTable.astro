---
interface Props {
  rows: readonly { servings: number; price: number }[];
  /** נדרש לנגישות: כל טבלה מקבלת caption שמסביר מה היא מתארת */
  caption: string;
  /** להציג את ה-caption או להסתיר אותו מהעין בלבד */
  showCaption?: boolean;
}

const { rows, caption, showCaption = false } = Astro.props;
---

<div class="table-scroll">
  <table class="price-table">
    <caption class:list={[showCaption ? 'price-table__caption' : 'sr-only']}>{caption}</caption>
    <thead>
      <tr>
        <th scope="col">מספר מנות</th>
        {rows.map((row) => <th scope="col"><span class="num">{row.servings}</span></th>)}
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">מחיר</th>
        {
          rows.map((row) => (
            <td>
              <span class="num">{row.price.toLocaleString('he-IL')}</span> ₪
            </td>
          ))
        }
      </tr>
    </tbody>
  </table>
</div>

<style>
  /* טבלה רחבה גוללת בתוך עצמה ולא שוברת את העמוד */
  .table-scroll {
    overflow-x: auto;
  }

  .price-table {
    inline-size: 100%;
    /* בלי תקרה הטבלה נמתחת על כל רוחב המסך ונראית ריקה */
    max-inline-size: 44rem;
    border-collapse: collapse;
  }

  .price-table__caption {
    text-align: start;
    font-weight: 600;
    margin-block-end: 0.75rem;
  }

  .price-table th,
  .price-table td {
    padding: 0.75rem 0.5rem;
    text-align: start;
    border-block-end: 1px solid var(--color-line);
    white-space: nowrap;
  }

  .price-table thead th {
    font-weight: 600;
    color: var(--color-ink-soft);
    font-size: 0.9375rem;
  }

  .price-table tbody th {
    font-weight: 600;
  }
</style>
