---
import type { Testimonial } from '../lib/content';

interface Props {
  testimonials: Testimonial[];
}

const { testimonials } = Astro.props;
---

<ul class="quotes">
  {
    testimonials.map((entry) => (
      <li class="quote">
        <p class="quote__rating">
          <span aria-hidden="true">{'★'.repeat(entry.data.rating)}</span>
          <span class="sr-only">
            דירוג <span class="num">{entry.data.rating}</span> מתוך 5
          </span>
        </p>
        <blockquote class="quote__text">{entry.data.text}</blockquote>
        <p class="quote__by">
          {entry.data.customerName}
          {entry.data.occasion && <span class="quote__occasion"> · {entry.data.occasion}</span>}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .quotes {
    display: grid;
    gap: 1.25rem;
    list-style: none;
  }

  .quote {
    padding: 1.5rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
  }

  .quote__rating {
    color: var(--color-accent);
    letter-spacing: 0.1em;
  }

  .quote__text {
    margin: 0.75rem 0 0;
    font-size: var(--text-lg);
  }

  .quote__by {
    margin-block-start: 1rem;
    font-weight: 600;
  }

  .quote__occasion {
    font-weight: 400;
    color: var(--color-ink-soft);
  }

  @media (min-width: 48rem) {
    .quotes {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
